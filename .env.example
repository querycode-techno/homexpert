# Copy to .env and fill in. Never commit real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority   # must be a replica set (checkout uses transactions)

# Customer API (/api/v1)
CUSTOMER_JWT_ACTIVE_KID=k1
CUSTOMER_JWT_PRIVATE_KEY=   # EC P-256 PEM (ES256)
OTP_PEPPER=                 # long random string
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_NOTIF_TEMPLATE_ID=
CRON_SECRET=

# Seeding / image URLs (address phones can reach, e.g. http://<lan-ip>:3012)
PUBLIC_ORIGIN=http://localhost:3012
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Run the API on port 3012 to match hx/user-app/.env:  pnpm exec next dev -p 3012
# Seed:  node scripts/seed/make-artwork.mjs && node --env-file=.env scripts/seed-customer-api.mjs
